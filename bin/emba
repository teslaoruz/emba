#!/usr/bin/env python3
"""emba: a red panda that keeps an eye on your coding agents.

usage: emba [command]

  start                 start Emba in the background (default)
  quit | restart        stop it / stop and start
  settings              open the settings window
  toggle | ask          open or close the island / open the ask box
  allow | deny          answer the oldest permission request
  set KEY VALUE         change a setting, e.g. emba set position top-left
  care, feed, play, nap, pet
                        look after Emba

  connect [AGENT ...] [--statusline]
                        hook Emba into claude, codex, gemini, opencode
                        (default: every one installed; shows each diff first)
  disconnect [AGENT ...]
  autostart on|off      start Emba when you log in

  look                  drag a rectangle on screen and ask about it
  listen                talk to Emba (voice must be on in settings)
  capture               just take the screenshot and print its path
  terminal DIR CMD...   open your terminal in DIR running CMD
  voice-install         download the local speech models (free, ~250 MB)
  plugins [new NAME]    list plugins, or start a new one in your config folder

  status [--json]       what is running and connected
  doctor                check everything Emba needs
  run                   run in the foreground (what autostart uses)
"""

import getpass
import importlib.util
import json
import os
import platform
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from importlib.machinery import SourceFileLoader
from pathlib import Path

APP = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(APP / "hook"))
import hooks  # noqa: E402


def _load_hook():
    # emba-hook has no .py suffix (agents run it directly), so load it by path
    loader = SourceFileLoader("emba_hook", str(APP / "hook" / "emba-hook"))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("emba_hook", loader))
    loader.exec_module(mod)
    return mod


hook = _load_hook()
SYSTEM = platform.system()  # Linux, Darwin, Windows
ASK_TOOLS = ["claude", "gemini", "opencode", "codex", "ollama"]


# ---------------------------------------------------------------- talking to the app

def ipc(cmd, *args, timeout=2.0):
    """Send a command to the running app; None if it is not running."""
    try:
        s = hook.connect()
    except OSError:
        return None
    try:
        s.settimeout(timeout)
        s.sendall((json.dumps({"ev": "ipc", "cmd": cmd, "args": list(args)}) + "\n").encode())
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(4096)
            if not chunk:
                break
            buf += chunk
        return json.loads(buf).get("reply") if buf else None
    except (OSError, ValueError):
        return None
    finally:
        s.close()


def running():
    return ipc("state", timeout=1.0) is not None


# ---------------------------------------------------------------- which host

def use_quickshell():
    """Quickshell on Wayland compositors with layer-shell; the Qt host everywhere else."""
    forced = os.environ.get("EMBA_HOST")
    if forced:
        return forced == "quickshell"
    desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
    return SYSTEM == "Linux" and bool(os.environ.get("WAYLAND_DISPLAY")) and shutil.which("qs") is not None \
        and "gnome" not in desktop


def host_command():
    if use_quickshell():
        return ["qs", "-p", str(APP)]
    py = venv_python()  # the one with PySide6
    if SYSTEM == "Windows" and py.lower().endswith("python.exe"):
        py = py[:-len("python.exe")] + "pythonw.exe"  # no console window
    return [py, str(APP / "desktop" / "host.py")]


def start():
    if running():
        print("Emba is already running")
        return
    if autostart_state() and SYSTEM == "Linux" and shutil.which("systemctl"):
        subprocess.run(["systemctl", "--user", "start", "emba.service"])
    else:
        kw = {"stdin": subprocess.DEVNULL, "stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL}
        if SYSTEM == "Windows":
            kw["creationflags"] = 0x00000008 | 0x00000200  # DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP
        else:
            kw["start_new_session"] = True
        subprocess.Popen(host_command(), **kw)
    for _ in range(40):
        time.sleep(0.15)
        if running():
            print("Emba is running")
            return
    sys.exit("Emba did not start; run `emba run` to see why")


# ---------------------------------------------------------------- autostart

def run_line():
    return [sys.executable, str(Path(__file__).resolve()), "run"]


def autostart_path():
    if SYSTEM == "Darwin":
        return Path.home() / "Library" / "LaunchAgents" / "dev.emba.plist"
    if SYSTEM == "Linux":
        if shutil.which("systemctl"):
            return hooks.config_home() / "systemd" / "user" / "emba.service"
        return hooks.config_home() / "autostart" / "emba.desktop"
    return None


RUN_KEY = r"Software\Microsoft\Windows\CurrentVersion\Run"


def autostart_state():
    if SYSTEM == "Windows":
        import winreg
        try:
            with winreg.OpenKey(winreg.HKEY_CURRENT_USER, RUN_KEY) as k:
                winreg.QueryValueEx(k, "Emba")
                return True
        except OSError:
            return False
    p = autostart_path()
    return bool(p and p.exists())


def autostart(on):
    if SYSTEM == "Windows":
        import winreg
        with winreg.OpenKey(winreg.HKEY_CURRENT_USER, RUN_KEY, 0, winreg.KEY_SET_VALUE) as k:
            if on:
                winreg.SetValueEx(k, "Emba", 0, winreg.REG_SZ, subprocess.list2cmdline(run_line()))
            else:
                try:
                    winreg.DeleteValue(k, "Emba")
                except OSError:
                    pass
    else:
        p = autostart_path()
        line = " ".join(f'"{a}"' for a in run_line())
        if SYSTEM == "Darwin":
            if on:
                p.parent.mkdir(parents=True, exist_ok=True)
                args = "".join(f"<string>{a}</string>" for a in run_line())
                p.write_text('<?xml version="1.0" encoding="UTF-8"?>\n'
                             '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" '
                             '"http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n'
                             f'<plist version="1.0"><dict><key>Label</key><string>dev.emba</string>'
                             f"<key>ProgramArguments</key><array>{args}</array>"
                             "<key>RunAtLoad</key><true/></dict></plist>\n")
            else:
                p.unlink(missing_ok=True)
        elif p.suffix == ".service":
            if on:
                p.parent.mkdir(parents=True, exist_ok=True)
                p.write_text("[Unit]\nDescription=Emba, a red panda that watches your coding agents\n"
                             "PartOf=graphical-session.target\nAfter=graphical-session.target\n\n"
                             f"[Service]\nExecStart={line}\nRestart=on-failure\nRestartSec=2\n\n"
                             "[Install]\nWantedBy=graphical-session.target\n")
                subprocess.run(["systemctl", "--user", "daemon-reload"])
                ipc("quit")  # hand over to systemd
                time.sleep(0.5)
                subprocess.run(["systemctl", "--user", "enable", "--now", "emba.service"], capture_output=True)
            else:
                subprocess.run(["systemctl", "--user", "disable", "emba.service"], capture_output=True)
                p.unlink(missing_ok=True)
                subprocess.run(["systemctl", "--user", "daemon-reload"])
        else:
            if on:
                p.parent.mkdir(parents=True, exist_ok=True)
                p.write_text(f"[Desktop Entry]\nType=Application\nName=Emba\nExec={line}\n")
            else:
                p.unlink(missing_ok=True)
    print("autostart", "on" if on else "off")


# ---------------------------------------------------------------- status

def user_data():
    if SYSTEM == "Windows":
        return Path(os.environ.get("LOCALAPPDATA", Path.home())) / "emba"
    if SYSTEM == "Darwin":
        return Path.home() / "Library" / "Application Support" / "emba"
    return Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share") / "emba"


def venv_dir():
    """Next to the app when that's writable (a git checkout), else per user (a package)."""
    here = APP / ".venv"
    return here if here.exists() or os.access(APP, os.W_OK) else user_data() / "venv"


def venv_python():
    """The app's own venv (PySide6, voice) if one was made."""
    p = venv_dir() / ("Scripts/python.exe" if SYSTEM == "Windows" else "bin/python")
    return str(p) if p.exists() else sys.executable


def voice_ready(py):
    r = subprocess.run([py, "-c", "import faster_whisper, sounddevice, piper"], capture_output=True)
    return r.returncode == 0


def capture():
    """Let the user drag a rectangle; print the PNG's path (nothing if cancelled)."""
    d = Path(tempfile.gettempdir()) / f"emba-{getpass.getuser()}"
    d.mkdir(exist_ok=True)
    out = d / f"capture-{time.strftime('%Y%m%d-%H%M%S')}.png"
    if SYSTEM == "Linux" and os.environ.get("WAYLAND_DISPLAY") and shutil.which("slurp") and shutil.which("grim"):
        # slurp reads preset boxes from a non-terminal stdin and would wait on it forever
        geo = subprocess.run(["slurp"], capture_output=True, text=True, stdin=subprocess.DEVNULL)
        if geo.returncode != 0 or not geo.stdout.strip():
            return
        subprocess.run(["grim", "-g", geo.stdout.strip(), str(out)])
    elif SYSTEM == "Darwin":
        subprocess.run(["screencapture", "-i", "-x", str(out)])
    else:
        subprocess.run([venv_python(), str(APP / "desktop" / "capture.py"), str(out)])
    if out.exists():
        print(out)


VOICE_PACKAGES = ["faster-whisper", "sounddevice", "piper-tts"]


def voice_install():
    """Put the voice packages in the app's own venv and fetch the models."""
    venv = venv_dir()
    if not venv.exists():
        venv.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run([sys.executable, "-m", "venv", str(venv)], check=True)
    py = venv_python()
    subprocess.run([py, "-m", "pip", "install", "--upgrade", "--quiet"] + VOICE_PACKAGES, check=True)
    subprocess.run([py, str(APP / "voice" / "voice.py"), "setup"], check=True)
    print("voice is ready: turn it on in emba settings")


def emba_config_dir():
    """Same rule as App.qml's configDir."""
    if os.environ.get("XDG_CONFIG_HOME"):
        return Path(os.environ["XDG_CONFIG_HOME"]) / "emba"
    if SYSTEM == "Windows":
        return Path(os.environ.get("APPDATA", Path.home())) / "emba"
    return Path.home() / ".config" / "emba"


def plugins():
    """Every plugin folder with a readable plugin.json; the user's win over bundled ones."""
    found = {}
    for builtin, root in ((True, APP / "plugins"), (False, emba_config_dir() / "plugins")):
        for manifest in sorted(root.glob("*/plugin.json")) if root.exists() else []:
            try:
                meta = json.loads(manifest.read_text(encoding="utf-8"))
            except (OSError, ValueError) as e:
                meta = {"error": str(e)}
            pid = manifest.parent.name
            found[pid] = {**meta, "id": pid, "dir": str(manifest.parent), "builtin": builtin}
    return list(found.values())


PLUGIN_TEMPLATE = {
    "name": "My plugin",
    "description": "What it does, in one line.",
    "events": {"finished": ["notify-send", "Emba", "{name} is done"]},
    "actions": [{"label": "Open folder", "run": ["xdg-open", "{cwd}"]}],
    "qml": "",
}


def plugins_cmd(rest):
    if rest[:1] == ["new"] and len(rest) > 1:
        d = emba_config_dir() / "plugins" / re.sub(r"[^a-z0-9-]+", "-", rest[1].lower()).strip("-")
        if d.exists():
            sys.exit(f"{d} already exists")
        d.mkdir(parents=True)
        (d / "plugin.json").write_text(json.dumps({**PLUGIN_TEMPLATE, "name": rest[1]}, indent=2) + "\n")
        print(f"created {d}\nedit plugin.json, then turn it on in emba settings")
        return
    for p in plugins():
        tag = "bundled" if p["builtin"] else "yours"
        print(f"{p['id']:<20} {p.get('name', '?')} ({tag}) — {p.get('error') or p.get('description', '')}")


# terminal emulator -> how to make it run a command (the folder comes from cwd=)
TERMINALS = [
    ("kitty", []), ("foot", []), ("ghostty", ["-e"]), ("alacritty", ["-e"]), ("wezterm", ["start", "--"]),
    ("konsole", ["-e"]), ("gnome-terminal", ["--"]), ("xfce4-terminal", ["-x"]), ("tilix", ["-e"]),
    ("xterm", ["-e"]),
]


def open_terminal(cwd, argv):
    """Open the user's terminal in `cwd` running `argv`. No shell is involved."""
    if not Path(cwd).is_dir():
        cwd = str(Path.home())
    if SYSTEM == "Darwin":
        line = f"cd {shlex.quote(cwd)} && " + " ".join(shlex.quote(a) for a in argv)
        subprocess.Popen(["osascript", "-e", "on run argv", "-e", 'tell application "Terminal" to do script (item 1 of argv)',
                          "-e", 'tell application "Terminal" to activate', "-e", "end run", line])
        return
    if SYSTEM == "Windows":
        exe = shutil.which(argv[0]) or argv[0]
        if shutil.which("wt"):
            subprocess.Popen(["wt", "-d", cwd, exe] + argv[1:])
        else:
            subprocess.Popen(["cmd", "/c", "start", "", "/D", cwd, "cmd", "/k", exe] + argv[1:])
        return
    # the user's choice first: $TERMINAL, then the desktop's default, then a guess
    chosen = os.environ.get("TERMINAL", "")
    prefix = None
    if chosen:
        prefix = [chosen] + next((args for name, args in TERMINALS if Path(chosen).name == name), ["-e"])
    elif shutil.which("xdg-terminal-exec"):
        prefix = ["xdg-terminal-exec"]
    else:
        prefix = next(([name] + args for name, args in TERMINALS if shutil.which(name)), None)
    if prefix is None:
        sys.exit("no terminal found; set $TERMINAL")
    subprocess.Popen(prefix + argv, cwd=cwd, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def focus_window(address):
    """Focus a Hyprland window, whichever dispatch syntax this Hyprland speaks."""
    if not re.fullmatch(r"0x[0-9a-fA-F]+", address or ""):
        return
    out = subprocess.run(["hyprctl", "dispatch", "focuswindow", f"address:{address}"], capture_output=True, text=True)
    if out.stdout.strip() != "ok":  # a Lua-configured Hyprland rejects the classic syntax
        subprocess.run(["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{address}" }})'], capture_output=True)


def status():
    return {
        "running": running(),
        "autostart": autostart_state(),
        "host": "quickshell" if use_quickshell() else "qt",
        "agents": hooks.status(),
        "ask": [t for t in ASK_TOOLS if shutil.which(t)],
        "python": venv_python(),
        "voice": voice_ready(venv_python()),
        "plugins": plugins(),
    }


def doctor():
    st = status()
    ok = True

    def line(good, what, hint="", required=True):
        nonlocal ok
        mark = "ok  " if good else ("MISS" if required else "    ")
        print(f"  {mark}  {what}" + (f"  ({hint})" if hint and not good else ""))
        if required and not good:
            ok = False

    print(f"Emba at {APP}  ({SYSTEM}, {st['host']} host)")
    if st["host"] == "quickshell":
        line(bool(shutil.which("qs")), "quickshell", "install quickshell")
    else:
        line(importlib.util.find_spec("PySide6") is not None, "PySide6", "pip install PySide6")
    line(st["running"], "running", "emba start", required=False)
    agents = st["agents"]
    found = [a for a, v in agents.items() if v["installed"]]
    line(bool(found), "a coding agent", "install claude, codex, gemini or opencode")
    for a in found:
        line(agents[a]["connected"], f"{a} connected", f"emba connect {a}", required=False)
    line(bool(st["ask"]), "something for the ask box", "any of: " + ", ".join(ASK_TOOLS), required=False)
    if SYSTEM == "Linux":
        line(bool(shutil.which("wl-copy") or shutil.which("xclip")), "clipboard tool (copy buttons)",
             "install wl-clipboard", required=False)
    print("All good." if ok else "Something Emba needs is missing.")
    return ok


# ---------------------------------------------------------------- main

def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "start"
    rest = args[1:]
    if cmd in ("-h", "--help", "help"):
        print(__doc__)
    elif cmd == "start":
        start()
    elif cmd in ("quit", "stop"):
        if ipc("quit") is None:
            print("Emba is not running")
    elif cmd == "restart":
        ipc("quit")
        time.sleep(0.6)
        start()
    elif cmd == "run":
        c = host_command()
        sys.exit(subprocess.call(c))
    elif cmd in ("settings", "toggle", "ask", "allow", "deny", "set", "state", "say", "care", "feed", "play", "nap", "pet", "followup", "continue", "snapshot"):
        if not running():
            start()
        reply = ipc(cmd, *rest)
        if reply and reply != "ok":
            print(reply)
    elif cmd in ("connect", "disconnect"):
        flags = rest + ([] if sys.stdin.isatty() else ["--yes"])
        sys.argv = ["hooks.py", "install" if cmd == "connect" else "uninstall"] + flags
        hooks.main()
    elif cmd == "autostart" and rest[:1] in (["on"], ["off"]):
        autostart(rest[0] == "on")
    elif cmd == "status":
        st = status()
        if rest[:1] == ["--json"]:
            print(json.dumps(st))
        else:
            print(f"running: {st['running']}\nautostart: {st['autostart']}\nhost: {st['host']}")
            for a, v in st["agents"].items():
                print(f"{a}: {'connected' if v['connected'] else 'installed' if v['installed'] else 'not installed'}")
    elif cmd == "focus" and rest:
        focus_window(rest[0])
    elif cmd == "terminal" and len(rest) >= 2:
        open_terminal(rest[0], rest[1:])
    elif cmd == "plugins":
        plugins_cmd(rest)
    elif cmd == "voice-install":
        voice_install()
    elif cmd == "capture":
        capture()
    elif cmd in ("look", "listen"):
        if not running():
            start()
        ipc(cmd)
    elif cmd == "doctor":
        sys.exit(0 if doctor() else 1)
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
