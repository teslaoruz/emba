#!/bin/sh
# emba: a red panda that keeps an eye on your Claude Code sessions.
set -eu

self=$(readlink -f "$0")
app=$(dirname "$(dirname "$self")")
unit="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/emba.service"

usage() {
    cat <<EOF
usage: emba [command]

  start               start Emba in the background (default)
  quit                stop it
  restart             stop, then start
  settings            open the settings window
  toggle | ask        open or close the island / open the ask box
  allow | deny        answer the oldest permission request
  set KEY VALUE       change a setting, e.g. set position top-left

  connect [--statusline]   add Emba's hooks to Claude Code (shows the diff first)
  disconnect               remove them again
  autostart on|off         start Emba with your graphical session (systemd)

  status [--json]     what is running and connected
  doctor              check everything Emba needs
  run                 run in the foreground (what autostart uses)
EOF
}

ipc() { qs -p "$app" ipc call emba "$@"; }
running() { qs -p "$app" ipc call emba state > /dev/null 2>&1; }
autostart_on() { [ -f "$unit" ] && systemctl --user is-enabled emba.service > /dev/null 2>&1; }

start() {
    if running; then
        echo "Emba is already running"
    elif autostart_on; then
        systemctl --user start emba.service
    else
        # setsid: keep running after the launching terminal closes
        setsid qs -p "$app" > /dev/null 2>&1 < /dev/null &
        sleep 1
        running && echo "Emba is running" || { echo "Emba failed to start; try: emba run"; exit 1; }
    fi
}

quit() {
    if autostart_on && systemctl --user is-active emba.service > /dev/null 2>&1; then
        systemctl --user stop emba.service
    else
        qs kill -p "$app" > /dev/null 2>&1 || true
    fi
}

hooks() {
    # interactive: show the diff and ask; from the settings window: --yes
    if [ -t 0 ]; then python3 "$app/hook/hooks.py" "$@"; else python3 "$app/hook/hooks.py" "$@" --yes; fi
}

status_json() {
    h=$(python3 "$app/hook/hooks.py" status)
    r=false; running && r=true
    a=false; autostart_on && a=true
    printf '{"running": %s, "autostart": %s, %s\n' "$r" "$a" "${h#\{}"
}

doctor() {
    ok=true
    check() { if eval "$2" > /dev/null 2>&1; then echo "  ok    $1"; else echo "  $3  $1${4:+  ($4)}"; if [ "$3" = "MISS" ]; then ok=false; fi; fi; }
    echo "Emba at $app"
    check "quickshell (qs)" "command -v qs" MISS "install quickshell"
    check "python3" "command -v python3" MISS
    check "claude (Claude Code)" "command -v claude" MISS "https://code.claude.com"
    check "running" running "    " "emba start"
    check "hooks in Claude Code" "python3 '$app/hook/hooks.py' status | grep -q '\"hooks\": true'" MISS "emba connect"
    check "usage limits (statusline)" "python3 '$app/hook/hooks.py' status | grep -q '\"statusline\": true'" "    " "emba connect --statusline"
    check "wl-copy (copy buttons)" "command -v wl-copy" "    " "install wl-clipboard"
    check "Hyprland (jump to terminal, eye tracking)" '[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]' "    " "set focusCommand for other compositors"
    $ok && echo "All good." || { echo "Something Emba needs is missing."; exit 1; }
}

cmd=${1:-start}
[ $# -gt 0 ] && shift
case "$cmd" in
start) start ;;
quit | stop) quit ;;
restart) quit; sleep 0.5; start ;;
run) exec qs -p "$app" ;;
set)
    running || start > /dev/null
    ipc set "$@"
    ;;
settings | toggle | ask | allow | deny)
    running || start > /dev/null
    ipc "$cmd" > /dev/null
    ;;
connect) hooks install "$@" ;;
disconnect) hooks uninstall ;;
autostart)
    case "${1:-}" in
    on)
        mkdir -p "$(dirname "$unit")"
        cat > "$unit" <<EOF
[Unit]
Description=Emba, a red panda that watches your Claude Code sessions
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=$self run
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
EOF
        systemctl --user daemon-reload
        qs kill -p "$app" > /dev/null 2>&1 || true
        systemctl --user enable --now emba.service > /dev/null
        echo "Emba starts with your session"
        ;;
    off)
        systemctl --user disable --now emba.service > /dev/null 2>&1 || true
        rm -f "$unit"
        systemctl --user daemon-reload
        echo "autostart off"
        ;;
    *) usage; exit 2 ;;
    esac
    ;;
status)
    if [ "${1:-}" = "--json" ]; then status_json; else status_json | tr -d '{}"' | tr ',' '\n' | sed 's/^ *//'; fi
    ;;
doctor) doctor ;;
-h | --help | help) usage ;;
*) usage; exit 2 ;;
esac
