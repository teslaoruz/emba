#!/usr/bin/env python3
"""Coding-agent hook for Emba. Standard library only, any OS.

Forwards each hook event to Emba over a local socket (a named pipe on
Windows). For permission requests it stays connected and waits for an answer.

Emba not running, slow, or gone -> exit 0 with no output, and the agent
carries on exactly as if this hook did not exist. A hook that prints nothing
never decides a permission, so every failure falls back to the normal
terminal prompt.

    emba-hook [--agent claude|codex|gemini]   as a hook: payload on stdin
    emba-hook statusline [CMD]                as Claude Code's statusLine: forwards
                                              the rate limits, then runs CMD (your
                                              old statusline) with the same stdin
"""

import getpass
import json
import os
import socket
import subprocess
import sys
import tempfile
from pathlib import Path

CONNECT_TIMEOUT = 0.3
DECISION_TIMEOUT = 570  # agents kill permission hooks at 600 s


def address():
    """Where Emba listens. Must match App.qml / the desktop host."""
    if os.environ.get("EMBA_SOCKET"):  # tests and demos run a separate Emba
        return os.environ["EMBA_SOCKET"]
    if os.name == "nt":
        return rf"\\.\pipe\emba-{getpass.getuser()}"
    base = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
    return str(Path(base) / ("emba.sock" if os.environ.get("XDG_RUNTIME_DIR") else f"emba-{os.getuid()}.sock"))


class Pipe:
    """Windows named pipe with the bits of the socket API we use."""

    def __init__(self, path):
        self.f = open(path, "r+b", buffering=0)

    def sendall(self, data):
        self.f.write(data)

    def recv(self, n):
        return self.f.read(n)

    def settimeout(self, t):
        pass  # a pipe read blocks until Emba answers or closes; the agent's own timeout bounds it

    def close(self):
        self.f.close()


def connect():
    if os.name == "nt":
        return Pipe(address())
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(CONNECT_TIMEOUT)
    s.connect(address())
    return s


def send(msg, wait=False):
    """Send one JSON line; with wait, return Emba's one-line JSON reply."""
    try:
        s = connect()
    except OSError:
        return None
    try:
        s.sendall((json.dumps(msg) + "\n").encode())
        if not wait:
            return None
        s.settimeout(DECISION_TIMEOUT)
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(4096)
            if not chunk:
                return None  # Emba closed on us: answered elsewhere
            buf += chunk
            if len(buf) > 65536:
                return None
        return json.loads(buf)
    except (OSError, ValueError):
        return None
    finally:
        s.close()


def target(tool, args):
    """The thing a tool call acts on, short enough for a one-line ticker."""
    if tool == "Bash" or (args.get("command") and isinstance(args.get("command"), str)):
        return args.get("command", "")
    for key in ("file_path", "notebook_path", "path", "url", "pattern", "query", "description", "prompt"):
        v = args.get(key)
        if v:
            return os.path.basename(v) if key in ("file_path", "notebook_path") else str(v)
    return ""


# Tools that ask the person a question instead of asking to do something.
QUESTION_TOOLS = {"AskUserQuestion", "request_user_input", "ask_user", "question"}


def questions(args):
    """The questions a question tool asks, in one shape for every agent."""
    raw = args.get("questions")
    if not isinstance(raw, list):
        raw = [args]
    out = []
    for q in raw[:4]:
        if not isinstance(q, dict):
            continue
        text = str(q.get("question") or q.get("prompt") or q.get("message") or "")[:2000]  # answers key on it
        opts = []
        for o in (q.get("options") or [])[:8]:
            o = o if isinstance(o, dict) else {"label": str(o)}
            opts.append({"label": str(o.get("label", ""))[:80], "description": str(o.get("description", ""))[:200]})
        if text:
            out.append({"question": text, "header": str(q.get("header", ""))[:40], "options": opts,
                        "multi": bool(q.get("multiSelect") or q.get("multiple"))})
    return out


def readable(args):
    """Tool arguments as short `key: value` lines, never raw JSON."""
    lines = []
    for k, v in args.items():
        if isinstance(v, (dict, list)):
            v = json.dumps(v, ensure_ascii=False)
        lines.append(f"{k}: {v}")
    return "\n".join(lines)[:2000]


def hypr_window(pid):
    """Address of the Hyprland window that owns `pid` or one of its parents."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return ""
    try:
        clients = json.loads(subprocess.run(
            ["hyprctl", "-j", "clients"], capture_output=True, text=True, timeout=2).stdout)
    except Exception:
        return ""
    owners = {c.get("pid"): c.get("address") for c in clients if c.get("pid")}
    for _ in range(16):
        if pid in owners:
            return owners[pid]
        try:
            stat = Path(f"/proc/{pid}/stat").read_text()
            pid = int(stat[stat.rindex(")") + 2:].split()[1])
        except Exception:
            return ""
        if pid <= 1:
            return ""
    return ""


def last_reply(transcript):
    """Last thing Claude said, read from the tail of the transcript."""
    try:
        with open(transcript, "rb") as fh:
            fh.seek(0, 2)
            fh.seek(max(0, fh.tell() - 200_000))
            lines = fh.read().decode(errors="ignore").splitlines()
    except OSError:
        return ""
    for line in reversed(lines):
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if rec.get("type") != "assistant":
            continue
        for part in reversed(rec.get("message", {}).get("content") or []):
            if isinstance(part, dict) and part.get("type") == "text" and part.get("text", "").strip():
                return part["text"].strip()[:600]
    return ""


def statusline(argv):
    raw = sys.stdin.buffer.read()
    try:
        data = json.loads(raw or b"{}")
        rl = data.get("rate_limits") or {}
        send({"ev": "Limits", "sid": data.get("session_id", ""), "model": (data.get("model") or {}).get("display_name", ""),
              "five_hour": rl.get("five_hour"), "seven_day": rl.get("seven_day")})
    except Exception:
        pass
    if argv:
        out = subprocess.run(argv[0] if len(argv) == 1 else argv, input=raw, shell=len(argv) == 1,
                             capture_output=True)
        sys.stdout.buffer.write(out.stdout)


# Each agent's event names, mapped onto Emba's (which are Claude Code's).
# Codex already uses the same names and output format.
GEMINI = {"BeforeAgent": "UserPromptSubmit", "BeforeTool": "PreToolUse", "AfterAgent": "Stop"}


def main():
    argv = sys.argv[1:]
    if argv[:1] == ["statusline"]:
        return statusline(argv[1:])
    agent = argv[argv.index("--agent") + 1] if "--agent" in argv[:-1] else "claude"
    if os.environ.get("EMBA_QUIET"):  # an agent Emba itself started (the ask box): not a session
        sys.stdin.read()
        if agent == "gemini":
            print("{}")
        return
    try:
        p = json.load(sys.stdin)
    except ValueError:
        return
    ev = p.get("hook_event_name", "")
    if agent == "agy":  # Antigravity: the event comes on the command line, the rest in its own names
        ev = {"PreInvocation": "UserPromptSubmit", "PostToolUse": "PreToolUse", "Stop": "Stop"}.get(
            argv[argv.index("--event") + 1] if "--event" in argv[:-1] else "", "")
        call = p.get("toolCall") or {}
        p = {**p, "session_id": p.get("conversationId", ""), "cwd": (p.get("workspacePaths") or [""])[0],
             "tool_name": call.get("name", ""), "tool_input": call.get("args") or {}}
        if not ev:
            return
    if agent == "gemini":
        if ev == "Notification" and p.get("notification_type") == "ToolPermission":
            ev = "Attention"  # Gemini cannot be answered from a hook: point at the terminal
        else:
            ev = GEMINI.get(ev, ev)
        p.setdefault("last_assistant_message", p.get("prompt_response", ""))
        print("{}")  # Gemini parses stdout as JSON; {} decides nothing
    tool = p.get("tool_name", "")
    args = p.get("tool_input") or {}
    if isinstance(args.get("command"), list):  # Codex passes argv
        args = {**args, "command": " ".join(map(str, args["command"]))}
    msg = {
        "ev": ev,
        "agent": agent,
        "sid": f"{agent}-{p.get('session_id', '')}" if agent != "claude" else p.get("session_id", ""),
        "cwd": p.get("cwd", "") or os.getcwd(),
        "pid": os.getppid(),
        "tool": tool,
        "target": target(tool, args)[:300],
    }
    if ev == "Attention":
        msg["text"] = p.get("message", "")
    elif ev == "SessionStart":
        msg["win"] = hypr_window(os.getppid())
    elif ev == "UserPromptSubmit":
        msg["target"] = (p.get("prompt") or "")[:300]
    elif ev == "Notification":
        msg["text"] = p.get("message", "")
    elif ev == "Stop":
        msg["text"] = p.get("last_assistant_message") or last_reply(p.get("transcript_path", ""))
    elif ev == "PermissionRequest":
        suggestions = p.get("permission_suggestions") or []
        asked = questions(args) if tool in QUESTION_TOOLS else []
        if asked:
            # only Claude Code takes answers from a hook; the others are answered in their terminal
            msg.update(questions=asked, answerable=agent == "claude")
        msg.update(id=p.get("tool_use_id") or f"{agent}-{os.getpid()}", full=target(tool, args) if tool == "Bash" else "" if asked else readable(args),
                   always=bool(suggestions),
                   rule=", ".join(r for s in suggestions if isinstance(s, dict) for r in (s.get("rules") or []))[:200])
        reply = send(msg, wait=True)
        if not reply or reply.get("behavior") not in ("allow", "deny"):
            return
        decision = {"behavior": reply["behavior"]}
        answers = reply.get("answers")
        if asked and reply["behavior"] == "allow":
            if agent != "claude" or not isinstance(answers, dict) or not answers:
                return  # no answers to give: the agent asks in its terminal
            # AskUserQuestion takes its answers as {question text: chosen label(s)}
            known = {q["question"] for q in asked}
            decision["updatedInput"] = {**(p.get("tool_input") or {}),
                                        "answers": {str(k): str(v)[:2000] for k, v in answers.items() if k in known}}
        if reply["behavior"] == "deny":
            decision["message"] = "Denied from emba."
        elif reply.get("always") and suggestions:
            decision["updatedPermissions"] = suggestions
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": decision}}))
        return
    send(msg)
    if agent == "codex" and ev in ("Stop", "UserPromptSubmit"):
        codex_limits(p.get("transcript_path", ""))


def codex_limits(path):
    """Codex writes its rate limits into the session log; send the latest."""
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 200_000))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return
    for line in reversed(lines):
        if '"rate_limits"' not in line:
            continue
        try:
            rl = json.loads(line).get("payload", {}).get("rate_limits") or {}
        except ValueError:
            continue
        names = {300: "5 hours", 10080: "This week", 43200: "This month"}
        windows = [{"label": names.get(w.get("window_minutes"), f"{w.get('window_minutes', 0) // 60} hours"),
                    "used": w.get("used_percent"), "resets": w.get("resets_at") or 0}
                   for w in (rl.get("primary"), rl.get("secondary")) if isinstance(w, dict)]
        if windows:
            send({"ev": "Limits", "agent": "codex", "model": rl.get("plan_type") or "", "windows": windows})
        return


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass  # never get in Claude Code's way
